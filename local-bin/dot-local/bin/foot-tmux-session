#!/bin/sh

use_tmux=true

# Alacritty launchers reuse this script for its environment setup without
# creating a tmux session. Accept Rofi's terminal-emulator separator in either
# order so this works as part of its `{terminal} -e {cmd}` template.
while [ "$#" -gt 0 ]; do
  case $1 in
    --no-tmux)
      use_tmux=false
      shift
      ;;
    -e)
      shift
      ;;
    *)
      break
      ;;
  esac
done

# Give each Foot-created tmux session a unique, recognizable name.
session_name="foot-$(date +%Y%m%d-%H%M%S)-$$"

if [ "$#" -eq 0 ]; then
  if [ "$use_tmux" = false ]; then
    exec zsh
  fi
  exec tmux new-session -s "$session_name"
fi

# Terminal=true desktop entries bypass the interactive Zsh hooks that normally
# set this title and export the user's shell environment. Look through an
# `env --chdir=… command` launcher so the initial title describes the actual
# working directory and application rather than the outer `env` process.
initial_directory=$PWD
application=${1##*/}
if [ "$application" = "env" ]; then
  find_application=false
  for argument do
    if [ "$find_application" = true ]; then
      application=${argument##*/}
      break
    fi
    case $argument in
      env|*/env)
        ;;
      --chdir=*)
        initial_directory=${argument#--chdir=}
        ;;
      --)
        find_application=true
        ;;
      -*|*=*)
        ;;
      *)
        application=${argument##*/}
        break
        ;;
    esac
  done
fi
pane_title="$initial_directory | $application"

if [ "$use_tmux" = false ]; then
  exec zsh -lc '
    source "$HOME/.config/zsh/environment.zsh"
    pane_title=$1
    shift
    printf "\033]0;%s\007" "$pane_title"
    exec "$@"
  ' zsh "$pane_title" "$@"
fi

exec tmux new-session -s "$session_name" zsh -lc '
  source "$HOME/.config/zsh/environment.zsh"
  pane_title=$1
  shift
  printf "\033]0;%s\007" "$pane_title"
  exec "$@"
' zsh "$pane_title" "$@"
