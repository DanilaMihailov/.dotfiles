# Shared transport defaults.
defaults
auth on
tls on
tls_starttls off
tls_trust_file system

# mihd@rtlq.ru via implicit TLS (SMTPS).
account rtlq
host mail.rtlq.ru
port 465
from mihd@rtlq.ru
user mihd@rtlq.ru
passwordeval gopass show --password mail.rtlq.ru/mihd < /dev/null

account default : rtlq
