[Unit]
Description=Watch RTLQ IMAP for changes
Documentation=https://gitlab.com/shackra/goimapnotify
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1d
StartLimitBurst=20

[Service]
Type=simple
ExecStart=/usr/bin/goimapnotify -conf %h/.config/goimapnotify/rtlq.yaml -wait 2
Restart=always
RestartSec=30s

[Install]
WantedBy=default.target
