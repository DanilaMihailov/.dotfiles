{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 4,
  "expand-left": true,
  "no-center": true,

  "modules-left": [
    "group/workspace-status"
  ],

  "modules-center": [],

  "modules-right": [
    "tray",
    "group/status-area"
  ],

  "group/status-area": {
    "orientation": "horizontal",
    "modules": [
      "custom/mattermost",
      "systemd-failed-units",
      "privacy",
      "group/system-monitor",
      "group/network-status",
      "group/device-controls",
      "group/power-status",
      "group/clock-notifications"
    ]
  },

  "group/workspace-status": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces",
      "custom/active-workspace",
      "hyprland/window"
    ]
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "show-special": true,
    "special-visible-only": true,
    "on-click": "activate",
    "format": "{id} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "󰘔",
    "window-rewrite": {
      "class<(firefox|Firefox)>": "",
      "class<(chromium|Chromium|google-chrome)>": "",
      "class<zen>": "󰖟",
      "class<(foot|footclient|Alacritty)> title<.*(nvim|Neovim).*>": "",
      "class<(foot|footclient|Alacritty)> title<.*(btop|Btop).*>": "󰨇",
      "class<(foot|footclient|Alacritty)> title<.*(codex|Codex).*>": "󰚩",
      "class<Alacritty> title<aerc>": "󰇮",
      "class<aerc>": "󰇮",
      "class<chroncal>": "󰃭",
      "class<(foot|footclient|Alacritty)> title<.*(tuxedo|Tuxedo|todo\\.txt).*>": "",
      "class<(foot|footclient|Alacritty)> title<\\[mosh\\].*>": "",
      "class<(foot|footclient|Alacritty)> title<.*(ssh|SSH).*>": "",
      "class<(foot|footclient|Alacritty)>": "",
      "class<(dolphin|org.kde.dolphin)>": "󰉋",
      "class<(code|Code|codium|VSCodium)>": "󰨞",
      "class<(discord|Discord|vesktop|Vesktop)>": "󰙯",
      "class<Mattermost.Desktop>": "",
      "class<org.mozilla.Thunderbird>": "",
      "class<(spotify|Spotify)>": "",
      "class<(steam|Steam)>": "",
      "class<(Throne|throne)>": "󰒍",
      "class<(blueman-manager)>": "󰂯"
    }
  },

  "custom/active-workspace": {
    "exec": "~/.config/waybar/active-workspace-name.py",
    "restart-interval": 1,
    "escape": true,
    "tooltip": false
  },

  "hyprland/window": {
    "expand": true,
    "separate-outputs": true
  },

  "hyprland/language": {
    "format": "{}",
    "min-length": 2,
    "format-en": "EN",
    "format-ru": "RU",
    "on-click": "hyprctl switchxkblayout all next"
  },

  "group/device-controls": {
    "orientation": "horizontal",
    "modules": [
      "idle_inhibitor",
      "custom/internal-display",
      "custom/game-mode",
      "hyprland/language",
      "pulseaudio"
    ]
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibition active — click to allow locking and sleep",
    "tooltip-format-deactivated": "Idle inhibition inactive — click to prevent locking and sleep"
  },

  "privacy": {
    "icon-size": 14,
    "icon-spacing": 8,
    "transition-duration": 0,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 18
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 18
      }
    ],
    "ignore-monitor": true
  },

  "systemd-failed-units": {
    "hide-on-ok": true,
    "format": "󰅚 {nr_failed}",
    "system": true,
    "user": true
  },

  "custom/clock": {
    "exec": "~/.config/waybar/clock-agenda.sh",
    "return-type": "json",
    "interval": 60,
    "escape": false,
    "on-click": "alacritty --class chroncal --title Chroncal -e /home/zen/.local/bin/foot-tmux-session --no-tmux chroncal"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format": "{ifname}: {essid}\nSignal: {signalStrength}%\n{ipaddr}",
    "on-click": "alacritty -e /home/zen/.local/bin/foot-tmux-session --no-tmux /usr/sbin/gazelle"
  },

  "bluetooth": {
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱",
    "format-no-controller": "󰂲",
    "tooltip-format-disabled": "Bluetooth disabled",
    "tooltip-format-off": "Bluetooth off",
    "tooltip-format-on": "Bluetooth on — no devices connected",
    "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "alacritty -e /home/zen/.local/bin/foot-tmux-session --no-tmux /usr/sbin/bluetui"
  },

  "group/network-status": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth",
      "custom/wireguard",
      "custom/throne"
    ]
  },

  "custom/wireguard": {
    "exec": "~/.config/waybar/wireguard-toggle.sh",
    "on-click": "~/.config/waybar/wireguard-toggle.sh toggle",
    "return-type": "json",
    "interval": 5,
    "signal": 8
  },

  "custom/throne": {
    "exec": "~/.config/waybar/throne-toggle.sh",
    "on-click": "~/.config/waybar/throne-toggle.sh toggle",
    "return-type": "json",
    "interval": 5,
    "signal": 9
  },

  "custom/internal-display": {
    "exec": "~/.config/waybar/internal-display-toggle.sh",
    "on-click": "~/.config/waybar/internal-display-toggle.sh toggle",
    "return-type": "json",
    "hide-empty-text": true,
    "interval": 2,
    "signal": 10
  },

  "custom/game-mode": {
    "exec": "~/.config/waybar/game-mode-toggle.sh",
    "on-click": "~/.config/waybar/game-mode-toggle.sh toggle",
    "return-type": "json",
    "hide-empty-text": true,
    "interval": 2,
    "signal": 11
  },

  "group/system-monitor": {
    "orientation": "horizontal",
    "modules": [
      "memory",
      "cpu",
      "temperature"
    ]
  },

  "memory": {
    "interval": 2,
    "format": "󰍛 {used:0.1f}G",
    "tooltip-format": "RAM: {used:0.1f} GiB used / {total:0.1f} GiB\nAvailable: {avail:0.1f} GiB",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "cpu": {
    "interval": 2,
    "format": " {usage:02}%",
    "tooltip-format": "CPU usage: {usage}%\nLoad: {load1} {load5} {load15}",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "temperature": {
    "interval": 5,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 90,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "tooltip-format": "CPU package temperature: {temperatureC}°C"
  },

  "pulseaudio": {
    "format": "",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{desc}: {volume}%",
    "on-click": "pavucontrol"
  },

  "group/power-status": {
    "orientation": "horizontal",
    "modules": [
      "custom/power-battery"
    ]
  },

  "custom/power-battery": {
    "exec": "~/.config/waybar/power-battery.sh",
    "on-click": "~/.config/waybar/power-battery.sh cycle",
    "return-type": "json",
    "hide-empty-text": true,
    "interval": 10,
    "signal": 12
  },

  "group/clock-notifications": {
    "orientation": "horizontal",
    "modules": ["custom/clock", "custom/notifications"]
  },

  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/mattermost": {
    "exec": "~/.config/waybar/mattermost-status.sh",
    "return-type": "json",
    "escape": false,
    "hide-empty-text": true,
    "interval": 2,
    "on-click": "~/.local/bin/focus-or-launch-app mattermost mattermost-desktop"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  }
}
