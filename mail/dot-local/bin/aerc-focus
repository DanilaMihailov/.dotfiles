#!/bin/sh
set -eu

message_query=${1:-}
window_address=$(
  hyprctl clients -j 2>/dev/null |
    jq -r '[.[] | select(
      .class == "aerc" or .initialClass == "aerc" or
      .title == "aerc" or .initialTitle == "aerc"
    )][0].address // empty' 2>/dev/null || true
)

if [ -n "$window_address" ]; then
  if [ -n "$message_query" ]; then
    aerc ":cf INBOX"
    aerc ":search $message_query"
  fi
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$window_address\" })"
else
  foot --app-id=aerc --title=aerc -e \
    "$HOME/.local/bin/foot-tmux-session" aerc
fi
