#!/bin/sh
set -eu
umask 077

account=
accounts=
limit=
batch_size=100
run_notmuch=yes
json_file=$(mktemp "${TMPDIR:-/tmp}/mail-archive-read.json.XXXXXX")
ids_file=$(mktemp "${TMPDIR:-/tmp}/mail-archive-read.ids.XXXXXX")
trap 'rm -f "$json_file" "$ids_file"' EXIT HUP INT TERM

usage() {
  cat <<'EOF'
Archive read Inbox messages locally through Himalaya.

Usage:
  mail-archive-read [OPTIONS] {rtlq|icloud|all}

Options:
  --limit N         Archive at most N messages per selected account.
  --batch-size N    Move N messages per batch (default: 100).
  --skip-notmuch    Do not run `notmuch new` after moving messages.
  -h, --help        Show this help.

The command modifies only local Maildirs. It does not start mail-sync;
the regular synchronization pipeline propagates moves to the servers later.
EOF
}

fail_usage() {
  printf 'mail-archive-read: %s\n\n' "$1" >&2
  usage >&2
  exit 2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --limit)
      [ "$#" -ge 2 ] || fail_usage '--limit requires a positive integer'
      case "$2" in
        ''|*[!0-9]*)
          fail_usage '--limit requires a positive integer'
          ;;
      esac
      [ "$2" -gt 0 ] || fail_usage '--limit requires a positive integer'
      limit=$2
      shift 2
      ;;
    --batch-size)
      [ "$#" -ge 2 ] || fail_usage '--batch-size requires a positive integer'
      case "$2" in
        ''|*[!0-9]*)
          fail_usage '--batch-size requires a positive integer'
          ;;
      esac
      [ "$2" -gt 0 ] || fail_usage '--batch-size requires a positive integer'
      batch_size=$2
      shift 2
      ;;
    --skip-notmuch)
      run_notmuch=no
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      fail_usage "unknown option: $1"
      ;;
    *)
      [ -z "$account" ] || fail_usage "unexpected argument: $1"
      account=$1
      shift
      ;;
  esac
done

case "$account" in
  rtlq|icloud)
    accounts=$account
    ;;
  all)
    accounts="rtlq icloud"
    ;;
  *)
    fail_usage 'account must be rtlq, icloud, or all'
    ;;
esac

archive_read() {
  current_account=$1
  moved=0

  # Count through the same backend and filter used below so progress reflects
  # the actual Maildir state, even if notmuch has not been refreshed yet.
  himalaya --account "$current_account" --json envelope search \
    --mailbox inbox --page-size 100000 'flag seen' > "$json_file"
  available=$(jq -r '.envelopes | length' "$json_file")
  total=$available
  if [ -n "$limit" ] && [ "$limit" -lt "$total" ]; then
    total=$limit
  fi

  printf 'component=mail-archive-read account=%s result=started total=%s available=%s\n' \
    "$current_account" "$total" "$available"

  while :; do
    page_size=$batch_size
    if [ -n "$limit" ]; then
      remaining=$((limit - moved))
      if [ "$remaining" -le 0 ]; then
        break
      fi
      if [ "$remaining" -lt "$page_size" ]; then
        page_size=$remaining
      fi
    fi

    himalaya --account "$current_account" --json envelope search \
      --mailbox inbox --page-size "$page_size" 'flag seen' > "$json_file"

    count=$(jq -r '.envelopes | length' "$json_file")
    if [ "$count" -eq 0 ]; then
      break
    fi

    jq -j '.envelopes[] | .id, "\u0000"' "$json_file" > "$ids_file"
    xargs -0 -r himalaya --account "$current_account" message move \
      --from inbox --to archive -- < "$ids_file"

    moved=$((moved + count))
    if [ "$total" -gt 0 ]; then
      percent=$((moved * 100 / total))
    else
      percent=100
    fi
    printf 'component=mail-archive-read account=%s result=progress moved=%s total=%s percent=%s\n' \
      "$current_account" "$moved" "$total" "$percent"
  done

  printf 'component=mail-archive-read account=%s result=success moved=%s total=%s\n' \
    "$current_account" "$moved" "$total"
}

for current_account in $accounts; do
  archive_read "$current_account"
done

if [ "$run_notmuch" = yes ]; then
  # Refresh aerc/notmuch locally. The regular mail-sync service will propagate
  # the moves to the servers on its next run.
  notmuch new
fi
