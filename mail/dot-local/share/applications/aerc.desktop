[Desktop Entry]
Type=Application
Name=aerc
GenericName=Email Client
Comment=Read and compose email in the terminal
Exec=alacritty --class aerc --title aerc -e /home/zen/.local/bin/foot-tmux-session --no-tmux aerc %u
Icon=aerc
Terminal=false
Categories=Network;Email;
MimeType=x-scheme-handler/mailto;
StartupNotify=false
StartupWMClass=aerc
