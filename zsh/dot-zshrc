docker-sleep() {
  local state_file="${XDG_RUNTIME_DIR}/docker-sleep-containers"
  docker ps -q > "$state_file"

  local containers=("${(@f)$(<"$state_file")}")
  (( ${#containers} )) && docker stop --timeout 30 "${containers[@]}"
}

docker-wake() {
  local state_file="${XDG_RUNTIME_DIR}/docker-sleep-containers"
  [[ -s "$state_file" ]] || return 0

  local containers=("${(@f)$(<"$state_file")}")
  docker start "${containers[@]}"
  rm "$state_file"
}

