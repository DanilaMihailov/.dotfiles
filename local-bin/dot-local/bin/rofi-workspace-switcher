#!/bin/sh

name=$(
  hyprctl -j workspaces 2>/dev/null |
    jq -r '
      sort_by(.name)[] |
      select(.name != "special") |
      select(.name | startswith("special:") | not) |
      .name | gsub("[\\n\\r\\t]"; " ")
    ' |
    rofi \
      -dmenu \
      -i \
      -matching fuzzy \
      -no-auto-select \
      -theme-str 'listview { require-input: false; }' \
      -p workspace
)
rofi_status=$?
[ "$rofi_status" -eq 0 ] || exit 0
[ -n "$name" ] || exit 0

# JSON strings are also valid Lua strings, so jq safely quotes names containing
# spaces or punctuation before embedding the selector in the dispatcher call.
workspace=$(printf 'name:%s' "$name" | jq -Rs '.') || exit 1

exec hyprctl dispatch "hl.dsp.focus({ workspace = $workspace })"
