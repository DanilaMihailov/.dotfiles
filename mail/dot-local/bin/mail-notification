#!/bin/sh
set -eu

message_query=${1:?missing notmuch message query}
message_json=$(notmuch show --format=json --body=false --entire-thread=false "$message_query")

sender=$(printf '%s' "$message_json" | jq -r '.[0][0][0].headers.From // "Unknown sender"' | tr '\r\n' '  ' | cut -c 1-160)
subject=$(printf '%s' "$message_json" | jq -r '.[0][0][0].headers.Subject // "(no subject)"' | tr '\r\n' '  ' | cut -c 1-240)

action=$(notify-send \
  --app-name=aerc \
  --icon=aerc \
  --category=email.arrived \
  --urgency=normal \
  --action=default=Open \
  --action=read='Mark Read' \
  --action=trash='Move to Trash' \
  "$sender" "$subject" || true)

case "$action" in
  default|open)
    "$HOME/.local/bin/aerc-focus" "$message_query"
    ;;
  read)
    notmuch tag -unread -- "$message_query"
    systemctl --user start mail-sync.service
    ;;
  trash)
    "$HOME/.local/bin/mail-action" trash "$message_query"
    ;;
esac
