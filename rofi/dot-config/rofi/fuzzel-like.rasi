* {
    background: rgba(40, 40, 40, 96%);
    background-alt: #3c3836;
    foreground: #ebdbb2;
    foreground-bright: #fbf1c7;
    muted: #928374;
    aqua: #8ec07c;
    blue: #83a598;
    yellow: #fabd2f;
    green: #b8bb26;
    match-highlight: bold #83a598;
    selected-match-highlight: bold #fabd2f;

    background-color: transparent;
    text-color: @foreground;
}

window {
    location: center;
    anchor: center;
    width: 42em;
    padding: 8px;
    border: 2px;
    border-radius: 5px;
    border-color: @green;
    background-color: @background;
}

mainbox {
    spacing: 2px;
}

inputbar {
    children: [ prompt, textbox-prompt-sep, entry ];
    spacing: 0;
    padding: 2px;
}

prompt {
    text-color: @aqua;
}

textbox-prompt-sep {
    expand: false;
    str: " ";
}

entry {
    text-color: @foreground-bright;
}

listview {
    lines: 12;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 0;
}

element {
    padding: 2px;
    border-radius: 0;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    highlight: @match-highlight;
}

element selected.normal {
    background-color: @background-alt;
    text-color: @foreground-bright;
}

element selected.normal element-text {
    highlight: @selected-match-highlight;
}
