[Desktop Entry]
Type=Application
Name=Chawan
GenericName=Web Browser
Comment=Browse the web in a terminal
Exec=env -u TMUX foot --app-id=chawan --title=Chawan cha --opt buffer.images=true --opt display.image-mode=sixel --visual
TryExec=cha
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
Keywords=web;browser;terminal;tui;
StartupNotify=true
StartupWMClass=chawan
