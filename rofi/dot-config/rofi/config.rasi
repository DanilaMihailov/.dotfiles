// @theme "/home/zen/.config/rofi/fuzzel-like.rasi"

configuration {
    modes: "combi,calc,filebrowser,actions:/home/zen/.local/bin/rofi-actions";
    font: "JetBrainsMono Nerd Font 13";
    terminal: "foot -e /home/zen/.local/bin/foot-tmux-session";
    show-icons: false;
    drun-match-fields: "name,generic,exec,categories,keywords";
    combi-modes: "window,drun,actions";
    combi-display-format: "<span foreground='#928374'>{mode}</span>  {text}";
    drun-display-format: "{name} <span size='small' alpha='60%'>{generic}</span>";
    window-format: "{t} — {c}";
    display-drun: "app";
    display-window: "win";
    display-calc: "calc";
    display-actions: "act";
    drun-show-actions: true;
    matching: "fuzzy";
    sorting-method: "fzf";
    sort: true;
    case-smart: true;
    disable-history: false;
    max-history-size: 30;
    filebrowser {
        command: "/home/zen/.local/bin/rofi-file-opener";
    }
    // display-drun: "❯";
}

@theme "/home/zen/.config/rofi/hyprland.rasi"

window {
    location: north;
    anchor: north;
    y-offset: 35%;
}

listview {
    require-input: true;
    lines: 12;
    dynamic: true;
    fixed-height: false;
}
