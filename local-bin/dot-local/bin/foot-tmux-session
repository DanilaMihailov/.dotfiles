#!/bin/sh

# Give each Foot-created tmux session a unique, recognizable name.
session_name="foot-$(date +%Y%m%d-%H%M%S)-$$"

if [ "$#" -eq 0 ]; then
  exec tmux new-session -s "$session_name"
fi

# Terminal=true desktop entries bypass the interactive Zsh hooks that normally
# set this title and export the user's shell environment. Initialize Zsh first,
# then replace it with the requested application.
application=${1##*/}
pane_title="$PWD | $application"

exec tmux new-session -s "$session_name" zsh -lic '
  pane_title=$1
  shift
  printf "\033]0;%s\007" "$pane_title"
  exec "$@"
' zsh "$pane_title" "$@"
