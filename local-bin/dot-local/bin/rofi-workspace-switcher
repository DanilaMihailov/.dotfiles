#!/bin/sh

workspaces=$(hyprctl -j workspaces 2>/dev/null) || exit 1

name=$(
  printf '%s\n' "$workspaces" |
    jq -r '
      sort_by(.name)[] |
      select(.name != "special") |
      select(.name | startswith("special:") | not) |
      .name | gsub("[\\n\\r\\t]"; " ")
    ' |
    rofi \
      -dmenu \
      -i \
      -matching fuzzy \
      -no-auto-select \
      -theme-str 'listview { require-input: false; }' \
      -p workspace
)
rofi_status=$?
[ "$rofi_status" -eq 0 ] || exit 0
[ -n "$name" ] || exit 0

# Existing workspace: switch to it by name. JSON strings are also valid Lua
# strings, so jq safely quotes names containing spaces or punctuation.
if printf '%s\n' "$workspaces" |
    jq -e --arg name "$name" 'any(.[]; .name == $name)' >/dev/null
then
  workspace=$(printf 'name:%s' "$name" | jq -Rs '.') || exit 1
  exec hyprctl dispatch "hl.dsp.focus({ workspace = $workspace })"
fi

# New workspace: create the lowest unused positive numeric ID first, then
# rename it. Renaming preserves that ID for direct number-key switching.
workspace_id=$(
  printf '%s\n' "$workspaces" |
    jq '
      [.[] | .id | select(. > 0)] as $used |
      first(
        range(1; 2147483648) as $id |
        select($used | index($id) | not) |
        $id
      )
    '
) || exit 1

quoted_name=$(printf '%s' "$name" | jq -Rs '.') || exit 1

hyprctl dispatch "hl.dsp.focus({ workspace = $workspace_id })" || exit 1

exec hyprctl dispatch \
  "hl.dsp.workspace.rename({ workspace = $workspace_id, name = $quoted_name })"
