[Desktop Entry]
Type=Application
Name=Screenshot: Fullscreen
Comment=Capture the monitor containing the active window
Exec=flock -n /tmp/hyprshot-fullscreen.lock hyprshot -m output -m active
TryExec=hyprshot
Icon=applets-screenshooter
Terminal=false
Categories=Graphics;
Keywords=screenshot;capture;fullscreen;monitor;output;screen;
StartupNotify=false
